{
  "description": "Blocks `gh pr create` when code changed but the living docs (ROADMAP/HANDOFF) did not.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/check-living-docs.sh\""
          }
        ]
      }
    ]
  }
}
